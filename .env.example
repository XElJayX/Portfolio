# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Nothing here is exposed to the
# browser except variables prefixed NEXT_PUBLIC_.

# --- Site -------------------------------------------------------------------
# Canonical URL used for SEO, sitemap, and Open Graph. On Vercel this falls back
# to the production domain automatically; set it if you use a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# --- Resume download notifications (Resend) --------------------------------
# Create a key at https://resend.com/api-keys ("Sending access" is enough).
# If unset, downloads still work — you just won't get an email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where notifications go (comma-separated for several addresses).
NOTIFY_EMAIL_TO=jayanthravimurugan@gmail.com
# Sender. The default onboarding@resend.dev only delivers to the email that owns
# the Resend account. Verify your own domain in Resend to use any address.
NOTIFY_EMAIL_FROM=Portfolio <onboarding@resend.dev>

# --- Live demos (optional; defaults point at the current deployments) ------
HF_SPACE_ID=ElJayy/mini-llm
HF_SPACE_URL=https://eljayy-mini-llm.hf.space
# Optional read token (https://huggingface.co/settings/tokens) — only raises
# Hub API rate limits for the status check. The Space itself is public.
HF_TOKEN=
TEXT_TO_SQL_API_URL=https://texttosql-production-b579.up.railway.app
